{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/resume/download/",
      "destination": "/resume/",
      "permanent": true
    },
    {
      "source": "/resume/download",
      "destination": "/resume/",
      "permanent": true
    },
    {
      "source": "/resume/sayed-asif-qa-engineer-resume.html",
      "destination": "/resume/",
      "permanent": true
    },
    {
      "source": "/capabilities/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/capabilities",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog/who-is-sayed-asif-qa-engineer.html",
      "destination": "/blog/who-is-sayed-asif-qa-engineer/",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/payments.html",
      "destination": "/projects/razorpay-payment-gateway-qa-automation/#payment-scenarios",
      "permanent": true
    },
    {
      "source": "/payments/",
      "destination": "/projects/razorpay-payment-gateway-qa-automation/#payment-scenarios",
      "permanent": true
    },
    {
      "source": "/payments",
      "destination": "/projects/razorpay-payment-gateway-qa-automation/#payment-scenarios",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy/",
      "permanent": true
    },
    {
      "source": "/projects/automationexercise.html",
      "destination": "/projects/automation-exercise/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://formspree.io"
        }
      ]
    },
    {
      "source": "/resume/(.*)\\.pdf",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/image/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
